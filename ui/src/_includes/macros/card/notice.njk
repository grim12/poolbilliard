{% from "macros/tag.njk" import tag %}

{#
    notice(title, url, tagText, tagColor, tagVariant, date, excerpt, size, extraClass, headingLevel)
    - title: Notice title
    - url: Link URL
    - tagText: Optional label (e.g. "DŮLEŽITÉ")
    - tagColor: "accent" (default) | "primary" | "dark" | "gold" | "gray"
    - tagVariant: "subtle" (default) | "solid" | "plain" | "outline"
    - date: Date string
    - excerpt: Optional lead paragraph — only rendered when size="lg"
    - size: "md" (default) — compact row with trailing arrow | "lg" — bigger stacked card with excerpt, no arrow
    - extraClass: Optional extra classes on root
    - headingLevel: "h3" (default) | "h4" | "h2" | "div"
#}
{% macro notice(
    title,
    url="#",
    tagText="",
    tagColor="accent",
    tagVariant="subtle",
    date="",
    excerpt="",
    size="md",
    extraClass="",
    headingLevel="h3"
) -%}
    {%- set sizeClass = "c-card--lg" if size == "lg" else "" -%}
    {%- set classes = ["c-card", "c-card--notice", sizeClass, extraClass] | select | join(" ") -%}
    <article class="{{ classes }}">
        <a href="{{ url }}" class="c-card__link" aria-label="{{ title }}">
            <div class="c-card__content">
                {% if tagText or date %}
                    <div class="c-card__meta">
                        {% if tagText %}
                            {{ tag(text=tagText, color=tagColor, variant=tagVariant, size="sm") }}
                        {% endif %}
                        {% if date %}
                            <time class="c-card__date">{{ date }}</time>
                        {% endif %}
                    </div>
                {% endif %}
                <{{ headingLevel }} class="c-card__title">{{ title }}</{{ headingLevel }}>
                {% if size == "lg" and excerpt %}
                    <p class="c-card__excerpt">{{ excerpt }}</p>
                {% endif %}
            </div>
            {% if size != "lg" %}
                {% icon "chevron-right", 24, "c-card__arrow", 20 %}
            {% endif %}
        </a>
    </article>
{%- endmacro %}
