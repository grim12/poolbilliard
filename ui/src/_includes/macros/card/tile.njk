{#
    card_tile(title, url, image, imageAlt, extraClass, headingLevel)
    - title: Tile label
    - url: Link URL
    - image: Background image URL
    - imageAlt: Alt text (leave empty — image is decorative, whole card is one link labelled via aria-label)
    - extraClass: Optional extra classes on root card
    - headingLevel: "h3" (default) | "h2" | "div"
#}
{% macro card_tile(
    title,
    url="#",
    image="",
    imageAlt="",
    extraClass="",
    headingLevel="h3"
) -%}
    {%- set classes = ["c-card", "c-card--tile", extraClass] | select | join(" ") -%}
    <article class="{{ classes }}">
        <a href="{{ url }}" class="c-card__link" aria-label="{{ title }}">
            {% if image %}
                <div class="c-card__media">
                    <img src="{{ image }}" alt="{{ imageAlt }}" loading="lazy" />
                </div>
            {% endif %}
            <div class="c-card__overlay"></div>
            <div class="c-card__body">
                <{{ headingLevel }} class="c-card__title">{{ title }}</{{ headingLevel }}>
                <svg class="c-card__arrow" width="22" height="22" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="M6 3.5L10.5 8L6 12.5"/>
                </svg>
            </div>
        </a>
    </article>
{%- endmacro %}
