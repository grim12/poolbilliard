{% from "macros/tag.njk" import tag %}

{#
    card_tournament(title, url, tagText, tagColor, tagVariant, dateText, locationText, badge, extraClass, headingLevel)
    - title: Tournament name
    - url: Link URL
    - tagText: Category text (e.g. "ČMBS", "MEZINÁRODNÍ")
    - tagColor: "primary" (default) | "accent" | "gold" | "dark" | "gray"
    - tagVariant: "plain" (default) | "solid" | "subtle" | "outline"
    - dateText: Date / date range string
    - locationText: "City · Venue" string
    - badge: true -> shows a gold medal badge (ranking-counting tournament) | false (default)
    - extraClass: Optional extra classes on root card
    - headingLevel: "h3" (default) | "h4" | "h2" | "div"
#}
{% macro card_tournament(
    title,
    url="#",
    tagText="",
    tagColor="primary",
    tagVariant="plain",
    dateText="",
    locationText="",
    badge=false,
    extraClass="",
    headingLevel="h3"
) -%}
    {%- set classes = ["c-card", "c-card--tournament", extraClass] | select | join(" ") -%}
    <article class="{{ classes }}">
        <a href="{{ url }}" class="c-card__link" aria-label="{{ title }}">
            <div class="c-card__header">
                {% if tagText %}
                    {{ tag(text=tagText, color=tagColor, variant=tagVariant, size="sm") }}
                {% endif %}
                {% if badge %}
                    <span class="c-card__badge" aria-hidden="true">
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="8" r="5"/><path d="M8.5 12.5 7 21l5-2.5 5 2.5-1.5-8.5"/></svg>
                    </span>
                {% endif %}
            </div>
            <div class="c-card__row">
                <{{ headingLevel }} class="c-card__title">{{ title }}</{{ headingLevel }}>
                <svg class="c-card__arrow" width="18" height="18" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="M6 3.5L10.5 8L6 12.5"/>
                </svg>
            </div>
            {% if dateText or locationText %}
                <div class="c-card__info">
                    {% if dateText %}<p class="c-card__date">{{ dateText }}</p>{% endif %}
                    {% if locationText %}<p class="c-card__location">{{ locationText }}</p>{% endif %}
                </div>
            {% endif %}
        </a>
    </article>
{%- endmacro %}
