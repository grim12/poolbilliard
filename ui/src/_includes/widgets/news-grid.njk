{% from "macros/card/article-grid.njk" import card_article_grid %}
{% from "macros/card/notice.njk" import notice %}
{% from "macros/button.njk" import button %}
{% from "macros/pagination.njk" import pagination %}
{% from "macros/tag.njk" import tag %}

{#
    newsGrid(items, sidebarTagText, sidebarTitle, sidebarItems, sidebarMoreUrl, sidebarMoreText, currentPage, totalPages, baseUrl, classes)
    - items: array of { title, url, image, tagText, tagColor, date, excerpt } — main article grid
    - sidebarItems: array of { title, url, tagText, tagColor, date } — "Důležité zprávy" sidebar list
#}
{% macro newsGrid(
    items=[],
    sidebarTagText="Výkonný výbor",
    sidebarTitle="Důležité zprávy",
    sidebarItems=[],
    sidebarMoreUrl="#",
    sidebarMoreText="Archiv všech zpráv",
    currentPage=1,
    totalPages=1,
    baseUrl="/novinky/",
    classes=""
) %}
<section class="c-section c-section--news-grid {{ classes }}">
    <div class="c-container">
        <div class="c-section__grid c-news-grid__layout">
            <div class="c-news-grid__main">
                <div class="c-news-grid__cards">
                    {% for item in items %}
                        {{ card_article_grid(
                            title=item.title,
                            url=item.url,
                            image=item.image,
                            tagText=item.tagText,
                            tagColor=item.tagColor,
                            date=item.date,
                            excerpt=item.excerpt
                        ) }}
                    {% endfor %}
                </div>

                {{ pagination(currentPage=currentPage, totalPages=totalPages, baseUrl=baseUrl) }}
            </div>

            {% if sidebarItems.length %}
                <aside class="c-news-grid__sidebar">
                    {% if sidebarTagText %}
                        {{ tag(text=sidebarTagText, color="primary", variant="plain", size="sm", extraClass="c-news-grid__sidebar-tag") }}
                    {% endif %}
                    <h2 class="h4 c-news-grid__sidebar-title">{{ sidebarTitle }}</h2>
                    <div class="c-news-grid__sidebar-list">
                        {% for item in sidebarItems %}
                            {{ notice(
                                title=item.title,
                                url=item.url,
                                tagText=item.tagText,
                                tagColor=item.tagColor,
                                date=item.date
                            ) }}
                        {% endfor %}
                    </div>
                    {{ button(text=sidebarMoreText, url=sidebarMoreUrl, variant="link", extraClass="w-full") }}
                </aside>
            {% endif %}
        </div>
    </div>
</section>
{% endmacro %}
