{% from "macros/card/notice.njk" import notice %}
{% from "macros/button.njk" import button %}

{#
    notices(title, subtitle, items, moreUrl, moreText)
    - items: array of { title, url, tagText, tagColor, date }
#}
{% macro notices(title, subtitle="", items=[], moreUrl="#", moreText="Všechny zprávy VV", classes="") %}
<section class="c-section c-section--notices {{ classes }}">
    <div class="c-container">
        <div class="c-section__header">
            <h2 class="c-section__title">{{ title }}</h2>
            {% if subtitle %}<p class="c-section__subtitle">{{ subtitle }}</p>{% endif %}
        </div>
        <div class="c-section__grid">
            {% for item in items %}
                {{ notice(
                    title=item.title,
                    url=item.url,
                    tagText=item.tagText,
                    tagColor=item.tagColor,
                    date=item.date
                ) }}
            {% endfor %}
        </div>
        <div class="c-section__footer">
            {{ button(text=moreText, url=moreUrl, variant="outline") }}
        </div>
    </div>
</section>
{% endmacro %}
