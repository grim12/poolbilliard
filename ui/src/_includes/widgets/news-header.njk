{% from "macros/back-link.njk" import backLink %}
{#
    newsHeader(title, subtitle, backText, backUrl, showSearch, searchPlaceholder, categories, classes)
    - backText / backUrl: optional "Zpět na …" link shown above the title (omit backUrl to hide it)
    - subtitle: optional lead paragraph shown under the title (e.g. on Kalendář)
    - showSearch: true (default) | false — some listings (e.g. Zprávy výboru) have no search/filter
    - categories: array of { text, value, isActive } — simple single-color filter pills, hidden when empty
    - Wrap the call in {% call newsHeader(...) %}...{% endcall %} to render custom content
      (e.g. the colored, checkable Kalendář filter) right-aligned next to the title/subtitle
      on desktop, stacked below it on mobile — used instead of `categories` when a plain
      single-color pill row isn't enough.
    - Search input and category filter are intentionally inert (no <form>/<a> navigation) — real
      filtering will be wired later via JS (fetch + history.pushState), not a full page reload.
#}
{% macro newsHeader(title="Novinky", subtitle="", backText="Zpět na novinky", backUrl="", showSearch=true, searchPlaceholder="Hledej ve zprávách", categories=[], classes="") %}
<section class="c-section c-section--news-header {{ classes }}">
    <div class="c-container">
        {% if backUrl %}
            {{ backLink(text=backText, url=backUrl, extraClass="c-news-header__back") }}
        {% endif %}

        <div class="c-news-header__top">
            <div class="c-news-header__intro">
                <h1 class="h1--big c-news-header__title{{ ' c-news-header__title--has-subtitle' if subtitle }}">{{ title }}</h1>
                {% if subtitle %}<p class="c-news-header__subtitle p--lg">{{ subtitle }}</p>{% endif %}
            </div>
            {% if caller %}
                <div class="c-news-header__aside">
                    {{ caller() }}
                </div>
            {% endif %}
        </div>

        {% if showSearch %}
            <div class="c-news-header__search">
                {% icon "magnifying-glass", 18, "c-news-header__search-icon" %}
                <input type="search" class="c-news-header__search-input" placeholder="{{ searchPlaceholder }}" aria-label="{{ searchPlaceholder }}" data-news-search />
            </div>
        {% endif %}

        {% if categories.length %}
            <div class="c-news-header__filters" role="group" aria-label="Filtrovat podle kategorie">
                {% for cat in categories %}
                    <button type="button" class="c-news-header__filter" aria-pressed="{{ 'true' if cat.isActive else 'false' }}" data-category="{{ cat.value }}">{{ cat.text }}</button>
                {% endfor %}
            </div>
        {% endif %}
    </div>
</section>
{% endmacro %}
