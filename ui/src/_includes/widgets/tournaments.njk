{% from "macros/card/tournament.njk" import card_tournament %}
{% from "macros/button.njk" import button %}

{#
    tournaments(title, items, calendarUrl, calendarText, streamText, streamLinkText, streamUrl)
    - items: array of { title, url, tagText, tagColor, dateText, locationText, badge, soon }
#}
{% macro tournaments(
    title,
    items=[],
    calendarUrl="#",
    calendarText="Kompletní kalendář",
    streamText="Přímé přenosy z turnajů sledujte na",
    streamLinkText="ČMBS TV",
    streamUrl="#",
    classes=""
) %}
<section class="c-section c-section--tournaments {{ classes }}">
    <div class="c-container">
        <div class="c-section__header">
            <h2 class="c-section__title">{{ title }}</h2>
        </div>
        <div class="c-section__grid">
            {% for item in items %}
                {{ card_tournament(
                    title=item.title,
                    url=item.url,
                    tagText=item.tagText,
                    tagColor=item.tagColor,
                    dateText=item.dateText,
                    locationText=item.locationText,
                    badge=item.badge,
                    soon=item.soon
                ) }}
            {% endfor %}
        </div>
        <div class="c-section__footer">
            {{ button(text=calendarText, url=calendarUrl, variant="outline") }}
            <p class="c-section__note">
                {% brandIcon "youtube", 20 %}
                <span>{{ streamText }} <a href="{{ streamUrl }}">{{ streamLinkText }}</a></span>
            </p>
        </div>
    </div>
</section>
{% endmacro %}
