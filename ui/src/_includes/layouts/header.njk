{% from "macros/button.njk" import button %}

<header class="c-header">
  <div class="c-header__topbar">
    <div class="c-container c-header__topbar-inner">
      <ul class="c-header__topbar-links">
        <li><a href="#">Návody a FAQ</a></li>
        <li>
          <a href="#" target="_blank" rel="noopener noreferrer">
            Web ČMBS
            <svg width="12" height="12" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 2h8v8M14 2 6.5 9.5M12 9v4a1 1 0 0 1-1 1H3a1 1 0 0 1-1-1V5a1 1 0 0 1 1-1h4"/></svg>
          </a>
        </li>
        <li><a href="#">Kontakt</a></li>
      </ul>

      <ul class="c-header__topbar-socials">
        <li>
          <a href="#" aria-label="Facebook">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M13.5 21v-7.5h2.5l.5-3h-3V8.5c0-.9.25-1.5 1.5-1.5H16.5V4.3c-.3 0-1.2-.1-2.3-.1-2.3 0-3.9 1.4-3.9 4V10.5H8v3h2.3V21h3.2Z"/></svg>
          </a>
        </li>
        <li>
          <a href="#" aria-label="Instagram">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><rect x="3.5" y="3.5" width="17" height="17" rx="4.5"/><circle cx="12" cy="12" r="4"/><circle cx="17.2" cy="6.8" r="0.9" fill="currentColor" stroke="none"/></svg>
          </a>
        </li>
        <li>
          <a href="#" aria-label="WhatsApp">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 3a9 9 0 0 0-7.8 13.5L3 21l4.6-1.2A9 9 0 1 0 12 3Zm4.9 12.8c-.2.6-1.2 1.1-1.7 1.2-.4.1-1 .1-1.6-.1-.4-.1-.9-.3-1.5-.6-2.6-1.1-4.3-3.8-4.4-4-.1-.2-1-1.3-1-2.5s.6-1.8.9-2c.2-.2.5-.3.7-.3h.5c.2 0 .4 0 .6.4.2.5.7 1.8.8 1.9.1.2.1.3 0 .5-.1.2-.1.3-.3.5l-.4.5c-.1.2-.3.3-.1.6.2.3.8 1.3 1.7 2.1 1.1 1 2.1 1.3 2.4 1.5.3.1.5.1.6-.1.2-.2.7-.8.9-1.1.2-.3.4-.2.6-.1.2.1 1.5.7 1.7.8.2.1.4.2.4.3.1.2.1.6-.1 1.1Z"/></svg>
          </a>
        </li>
        <li>
          <a href="#" class="c-header__topbar-tv">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><rect x="2" y="5" width="20" height="14" rx="3" fill="none" stroke="currentColor" stroke-width="1.6"/><path d="M10 9.5v5l4.5-2.5Z"/></svg>
            ČMBS TV
          </a>
        </li>
      </ul>
    </div>
  </div>

  <div class="c-header__main">
    <div class="c-container c-header__main-inner">
      <a href="/" class="c-header__brand" aria-label="Český pool — domů">
        <svg class="c-header__brand-mark" viewBox="0 0 40 40" aria-hidden="true">
          <circle cx="20" cy="20" r="19" fill="var(--color-accent-600)"/>
          <circle cx="20" cy="20" r="12" fill="white"/>
          <text x="20" y="24.5" text-anchor="middle" font-size="13" font-weight="900" fill="var(--color-dark)">8</text>
        </svg>
        <span class="c-header__brand-text">
          <span class="c-header__brand-line">Český</span>
          <span class="c-header__brand-line c-header__brand-line--bold">Pool</span>
        </span>
      </a>

      <nav class="c-header__nav" aria-label="Hlavní navigace">
        <a class="c-header__nav-link" href="#">Novinky</a>
        <a class="c-header__nav-link" href="#">Kalendář</a>
        <a class="c-header__nav-link" href="#">Kde hrát</a>
        <a class="c-header__nav-link" href="#">Žebříčky</a>
        <a class="c-header__nav-link" href="#">Jak začít</a>
        <a class="c-header__nav-link" href="#">Svaz</a>
      </nav>

      <div class="c-header__actions">
        {{ button(text="Registrace na turnaje", url="#", color="accent", size="md") }}
      </div>

      <button type="button" class="c-header__toggle" data-header-toggle aria-expanded="false" aria-controls="header-mobile-panel" aria-label="Otevřít menu">
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M4 6h16M4 12h16M4 18h16"/></svg>
      </button>
    </div>

    <div class="c-header__mobile-panel" id="header-mobile-panel" data-header-panel hidden>
      <a class="c-header__nav-link" href="#">Novinky</a>
      <a class="c-header__nav-link" href="#">Kalendář</a>
      <a class="c-header__nav-link" href="#">Kde hrát</a>
      <a class="c-header__nav-link" href="#">Žebříčky</a>
      <a class="c-header__nav-link" href="#">Jak začít</a>
      <a class="c-header__nav-link" href="#">Svaz</a>
      {{ button(text="Registrace na turnaje", url="#", color="accent", size="md", extraClass="w-full justify-center mt-2") }}
    </div>
  </div>
</header>
