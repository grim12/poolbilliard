{% from "macros/button.njk" import button %}

{% set navItems = [
    {
        text: "Novinky",
        url: "#",
        children: [
            { text: "Všechny novinky", url: "#" },
            { text: "Zprávy výkonného výboru", url: "#" },
            { text: "Tiskové zprávy", url: "#" }
        ]
    },
    { text: "Kalendář", url: "#" },
    {
        text: "Kde hrát",
        url: "#",
        children: [
            { text: "Kluby", url: "#" },
            { text: "Herny", url: "#" },
            { text: "Najít nejbližší stůl", url: "#" }
        ]
    },
    { text: "Žebříčky", url: "#" },
    {
        text: "Jak začít",
        url: "#",
        isActive: true,
        children: [
            { text: "Jak začít hrát", url: "#" },
            { text: "Pravidla kulečníku", url: "#" },
            { text: "Registrace hráče", url: "#" }
        ]
    },
    { text: "Svaz", url: "#" }
] %}

{#
    navDropdown(text, url, items, isActive)
    - Desktop nav link with a chevron + hover/focus dropdown panel of demo links
#}
{% macro navDropdown(text, url, items, isActive=false) %}
<div class="c-header__nav-item">
    <a class="c-header__nav-link{{ ' c-header__nav-link--is-active' if isActive }}" href="{{ url }}" aria-haspopup="true">
        {{ text }}
        <svg class="c-header__nav-chevron" width="14" height="14" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m4 6 4 4 4-4"/></svg>
    </a>
    <div class="c-header__dropdown">
        {% for item in items %}
            <a class="c-header__dropdown-link" href="{{ item.url }}">{{ item.text }}</a>
        {% endfor %}
    </div>
</div>
{% endmacro %}

{#
    mobileNavItem(text, url, children, isActive)
    - Mobile nav link; when children are given, renders a tap-to-expand accordion instead
#}
{% macro mobileNavItem(text, url, children, isActive=false) %}
{% if children %}
<div class="c-header__mobile-nav-item" data-accordion>
    <button type="button" class="c-header__nav-link c-header__mobile-nav-toggle" data-accordion-toggle aria-expanded="false">
        {{ text }}
        <svg class="c-header__nav-chevron" width="14" height="14" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m4 6 4 4 4-4"/></svg>
    </button>
    <div class="c-header__mobile-nav-sublist" data-accordion-panel>
        {% for child in children %}
            <a class="c-header__mobile-nav-sublink" href="{{ child.url }}">{{ child.text }}</a>
        {% endfor %}
    </div>
</div>
{% else %}
<a class="c-header__nav-link{{ ' c-header__nav-link--is-active' if isActive }}" href="{{ url }}">{{ text }}</a>
{% endif %}
{% endmacro %}

<header class="c-header">
  <div class="c-header__topbar">
    <div class="c-container c-header__topbar-inner">
      <ul class="c-header__topbar-links">
        <li><a href="#">FAQ</a></li>
        <li>
          <a href="#" target="_blank" rel="noopener noreferrer">
            ČMBS
            <svg width="12" height="12" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 2h8v8M14 2 6.5 9.5M12 9v4a1 1 0 0 1-1 1H3a1 1 0 0 1-1-1V5a1 1 0 0 1 1-1h4"/></svg>
          </a>
        </li>
      </ul>

      <ul class="c-header__topbar-socials">
        <li>
          <a href="#" target="_blank" rel="noopener noreferrer" aria-label="Facebook">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M15 8h-1.5A1.5 1.5 0 0 0 12 9.5V12m0 0H9.5M12 12v6M9.5 12H12"/></svg>
          </a>
        </li>
        <li>
          <a href="#" target="_blank" rel="noopener noreferrer" aria-label="Instagram">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.5" cy="6.5" r="1" fill="currentColor" stroke="none"/></svg>
          </a>
        </li>
        <li>
          <a href="#" target="_blank" rel="noopener noreferrer" aria-label="WhatsApp">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 3a9 9 0 0 0-7.8 13.4L3 21l4.8-1.2A9 9 0 1 0 12 3Z"/><path d="M8.7 8.7c.2-.5.4-.5.7-.5h.5c.2 0 .4 0 .5.4l.7 1.5c.1.3.1.5-.1.7l-.4.4c-.1.2-.1.3 0 .5.4.7 1.4 1.7 2.1 2.1.2.1.3.1.5 0l.4-.4c.2-.2.4-.2.7-.1l1.5.7c.4.2.4.4.4.6v.5c0 .3 0 .5-.5.7-1 .4-2.4.2-4-.9-1.6-1.1-2.7-2.5-3-3.9-.1-.7 0-1.3.1-1.7Z"/></svg>
          </a>
        </li>
        <li>
          <a href="#" class="c-header__topbar-tv" target="_blank" rel="noopener noreferrer">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><rect x="2" y="5" width="20" height="14" rx="3" fill="none" stroke="currentColor" stroke-width="1.6"/><path d="M10 9.5v5l4.5-2.5Z"/></svg>
            ČMBS TV
          </a>
        </li>
      </ul>
    </div>
  </div>

  <div class="c-header__main">
    <div class="c-container c-header__main-inner">
      <a href="/" class="c-header__brand" aria-label="Český pool — domů">
        <img class="c-header__brand-logo" src="/uploads/cesky_pool.png" alt="Český Pool" />
      </a>

      <nav class="c-header__nav" aria-label="Hlavní navigace">
        {% for item in navItems %}
            {% if item.children %}
                {{ navDropdown(item.text, item.url, item.children, item.isActive) }}
            {% else %}
                <a class="c-header__nav-link{{ ' c-header__nav-link--is-active' if item.isActive }}" href="{{ item.url }}">{{ item.text }}</a>
            {% endif %}
        {% endfor %}
      </nav>

      <div class="c-header__actions">
        {{ button(text="Registrace na turnaje", url="#", color="accent", size="sm", hasArrow=false) }}

        <div class="c-header__utility">
          <div class="c-header__lang">
            <button type="button" class="c-header__lang-btn" aria-haspopup="true" aria-expanded="false">
              CZ
              <svg class="c-header__lang-chevron" width="12" height="12" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m4 6 4 4 4-4"/></svg>
            </button>
            <div class="c-header__lang-dropdown">
              <a href="#" class="c-header__lang-option c-header__lang-option--is-active">CZ — Čeština</a>
              <a href="#" class="c-header__lang-option">EN — English</a>
            </div>
          </div>

          <button type="button" class="c-header__search-toggle" data-search-toggle aria-expanded="false" aria-controls="header-search-panel" aria-label="Hledat">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/></svg>
          </button>
        </div>
      </div>

      <button type="button" class="c-header__toggle" data-header-toggle aria-expanded="false" aria-controls="header-mobile-panel" aria-label="Otevřít menu">
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M4 6h16M4 12h16M4 18h16"/></svg>
      </button>
    </div>

    <div class="c-header__search-panel" id="header-search-panel" data-search-panel>
      <div class="c-container c-header__search-panel-inner">
        <form class="c-header__search-form" role="search" action="#" method="get">
          <button type="submit" class="c-header__search-submit" aria-label="Hledat">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/></svg>
          </button>
          <input type="search" name="q" class="c-header__search-input" data-search-input placeholder="Hledat kluby, hráče, novinky…" />
        </form>
        <button type="button" class="c-header__search-close" data-search-close aria-label="Zavřít vyhledávání">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 6l12 12M18 6 6 18"/></svg>
        </button>
      </div>
    </div>

    <div class="c-header__mobile-panel" id="header-mobile-panel" data-header-panel hidden>
      {% for item in navItems %}
          {{ mobileNavItem(item.text, item.url, item.children, item.isActive) }}
      {% endfor %}

      <div class="c-header__mobile-utility">
        <div class="c-header__lang-switch" role="group" aria-label="Přepnout jazyk">
          <button type="button" class="c-header__lang-switch-option c-header__lang-switch-option--is-active">CZ</button>
          <button type="button" class="c-header__lang-switch-option">EN</button>
        </div>

        <button type="button" class="c-header__search-toggle" data-search-toggle aria-expanded="false" aria-controls="header-mobile-search-panel" aria-label="Hledat">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/></svg>
        </button>
      </div>

      <div class="c-header__mobile-search" id="header-mobile-search-panel" data-search-panel>
        <div class="c-header__mobile-search-inner">
          <form class="c-header__search-form" role="search" action="#" method="get">
            <button type="submit" class="c-header__search-submit" aria-label="Hledat">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/></svg>
            </button>
            <input type="search" name="q" class="c-header__search-input" data-search-input placeholder="Hledat kluby, hráče, novinky…" />
          </form>
          <button type="button" class="c-header__search-close" data-search-close aria-label="Zavřít vyhledávání">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 6l12 12M18 6 6 18"/></svg>
          </button>
        </div>
      </div>
    </div>
  </div>
</header>
