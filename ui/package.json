{
  "name": "poolbilliard-ui",
  "version": "0.1.0",
  "private": true,
  "description": "UI šablony a komponenty pro ČMBS / Poolbilliard (Eleventy + Nunjucks + Tailwind CSS 4)",
  "scripts": {
    "build:css": "postcss src/styles/style.css -o src/css/style.css",
    "dev": "concurrently -k -n css,eleventy \"postcss src/styles/style.css -o src/css/style.css --watch\" \"eleventy --serve\"",
    "start": "npm run dev",
    "build": "npm run build:css && eleventy",
    "clean": "rimraf _site src/css/style.css"
  },
  "devDependencies": {
    "@11ty/eleventy": "^3.0.0",
    "@tailwindcss/postcss": "^4.0.0",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.1.2",
    "glightbox": "^3.3.1",
    "heroicons": "^2.2.0",
    "postcss": "^8.5.1",
    "postcss-cli": "^11.0.0",
    "rimraf": "^6.0.1",
    "simple-icons": "^16.30.0",
    "tailwindcss": "^4.0.0"
  }
}
